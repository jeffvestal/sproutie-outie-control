      "already_configured": "\u0426\u0435\u0439 \u043c\u043e\u0434\u0435\u043c \u0432\u0436\u0435 \u043d\u0430\u043b\u0430\u0448\u0442\u043e\u0432\u0430\u043d\u043e"
    },
    "error": {
      "cannot_connect": "\u041d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f \u043f\u0456\u0434\u043a\u043b\u044e\u0447\u0438\u0442\u0438\u0441\u044f \u0434\u043e \u043c\u043e\u0434\u0435\u043c\u0443.\n\n\u0411\u0443\u0434\u044c \u043b\u0430\u0441\u043a\u0430, \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u0442\u0435:\n1. IP-\u0430\u0434\u0440\u0435\u0441\u0430 \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u0430 (\u0437\u0430\u0437\u0432\u0438\u0447\u0430\u0439 192.168.100.1)\n2. \u042f\u043a\u0449\u043e \u043c\u043e\u0434\u0435\u043c \u0432\u0438\u043c\u0430\u0433\u0430\u0454 \u0430\u0432\u0442\u0435\u043d\u0442\u0438\u0444\u0456\u043a\u0430\u0446\u0456\u0457, \u0432\u0432\u0435\u0434\u0456\u0442\u044c \u0456\u043c'\u044f \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0430/\u043f\u0430\u0440\u043e\u043b\u044c\n3. \u0412\u0435\u0431-\u0456\u043d\u0442\u0435\u0440\u0444\u0435\u0439\u0441 \u043c\u043e\u0434\u0435\u043c\u0443 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0438\u0439 \u0437 \u043c\u0435\u0440\u0435\u0436\u0456 Home Assistant\n\n\u042f\u043a\u0449\u043e \u0432\u0430\u0448 \u043c\u043e\u0434\u0435\u043c \u043d\u0435 \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0454\u0442\u044c\u0441\u044f, \u0432\u0438\u0431\u0435\u0440\u0456\u0442\u044c '\u041d\u0435\u0432\u0456\u0434\u043e\u043c\u0438\u0439 \u043c\u043e\u0434\u0435\u043c (\u0440\u0435\u0437\u0435\u0440\u0432\u043d\u0438\u0439 \u0440\u0435\u0436\u0438\u043c)', \u0449\u043e\u0431 \u0443\u0432\u0456\u043c\u043a\u043d\u0443\u0442\u0438 \u0431\u0430\u0437\u043e\u0432\u0438\u0439 \u043c\u043e\u043d\u0456\u0442\u043e\u0440\u0438\u043d\u0433 \u0442\u0430 \u0437\u0430\u0445\u043e\u043f\u043b\u0435\u043d\u043d\u044f HTML.",
      "invalid_auth": "\u041d\u0435\u0432\u0456\u0440\u043d\u0435 \u0456\u043c'\u044f \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0430 \u0430\u0431\u043e \u043f\u0430\u0440\u043e\u043b\u044c. \u041f\u0435\u0440\u0435\u0432\u0456\u0440\u0442\u0435 \u043e\u0431\u043b\u0456\u043a\u043e\u0432\u0456 \u0434\u0430\u043d\u0456 \u0442\u0430 \u0441\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0449\u0435 \u0440\u0430\u0437.",
      "invalid_input": "\u041d\u0435\u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u0435 \u0432\u0432\u0435\u0434\u0435\u043d\u043d\u044f. \u041f\u0435\u0440\u0435\u0432\u0456\u0440\u0442\u0435 \u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0442\u0430 \u0441\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0437\u043d\u043e\u0432\u0443.",
      "network_unreachable": "\u041d\u0435 \u0432\u0434\u0430\u0454\u0442\u044c\u0441\u044f \u0437\u0432'\u044f\u0437\u0430\u0442\u0438\u0441\u044f \u0437 \u043c\u043e\u0434\u0435\u043c\u043e\u043c - \u043f\u0440\u043e\u0431\u043b\u0435\u043c\u0430 \u043c\u0435\u0440\u0435\u0436\u0435\u0432\u043e\u0433\u043e \u0437'\u0454\u0434\u043d\u0430\u043d\u043d\u044f.\n\n\u0411\u0443\u0434\u044c \u043b\u0430\u0441\u043a\u0430, \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u0442\u0435:\n1. \u041c\u0435\u0440\u0435\u0436\u0435\u0432\u0435 \u0437'\u0454\u0434\u043d\u0430\u043d\u043d\u044f - \u0412\u0438 \u043f\u0456\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u0456 \u0434\u043e \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e\u0457 \u043c\u0435\u0440\u0435\u0436\u0456 WiFi?\n2. \u0413\u043e\u0441\u0442\u044c\u043e\u0432\u0438\u0439 WiFi - \u0413\u043e\u0441\u0442\u044c\u043e\u0432\u0456 \u043c\u0435\u0440\u0435\u0436\u0456 \u0447\u0430\u0441\u0442\u043e \u0431\u043b\u043e\u043a\u0443\u044e\u0442\u044c \u0434\u043e\u0441\u0442\u0443\u043f \u0434\u043e \u043b\u043e\u043a\u0430\u043b\u044c\u043d\u0438\u0445 \u043f\u0440\u0438\u0441\u0442\u0440\u043e\u0457\u0432\n3. VPN - \u0412\u0456\u0434'\u0454\u0434\u043d\u0430\u0439\u0442\u0435 \u0430\u043a\u0442\u0438\u0432\u043d\u0456 VPN-\u0437'\u0454\u0434\u043d\u0430\u043d\u043d\u044f\n4. IP-\u0430\u0434\u0440\u0435\u0441\u0430 - \u041f\u0435\u0440\u0435\u0432\u0456\u0440\u0442\u0435 IP \u043c\u043e\u0434\u0435\u043c\u0443 (\u0437\u0430\u0437\u0432\u0438\u0447\u0430\u0439 192.168.100.1)\n5. \u0412\u0435\u0431-\u0456\u043d\u0442\u0435\u0440\u0444\u0435\u0439\u0441 \u043c\u043e\u0434\u0435\u043c\u0443 - \u041f\u0435\u0440\u0435\u043a\u043e\u043d\u0430\u0439\u0442\u0435\u0441\u044f, \u0449\u043e \u0432\u0456\u043d \u0443\u0432\u0456\u043c\u043a\u043d\u0435\u043d\u0438\u0439 \u0442\u0430 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0438\u0439\n6. \u041f\u043e\u0432\u0456\u043b\u044c\u043d\u0430 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u044c - \u0414\u0435\u044f\u043a\u0456 \u043c\u043e\u0434\u0435\u043c\u0438 \u043f\u043e\u0442\u0440\u0435\u0431\u0443\u044e\u0442\u044c \u043a\u0456\u043b\u044c\u043a\u0430 \u0441\u0435\u043a\u0443\u043d\u0434 \u0434\u043b\u044f \u043f\u0440\u043e\u0431\u0443\u0434\u0436\u0435\u043d\u043d\u044f; \u0441\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u043d\u0430\u0434\u0456\u0441\u043b\u0430\u0442\u0438 \u0437\u043d\u043e\u0432\u0443\n\n\u0421\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u043e\u0442\u0440\u0438\u043c\u0430\u0442\u0438 \u0434\u043e\u0441\u0442\u0443\u043f \u0434\u043e \u043c\u043e\u0434\u0435\u043c\u0443 \u0431\u0435\u0437\u043f\u043e\u0441\u0435\u0440\u0435\u0434\u043d\u044c\u043e \u0432 \u0431\u0440\u0430\u0443\u0437\u0435\u0440\u0456, \u0449\u043e\u0431 \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u0438\u0442\u0438 \u0437'\u0454\u0434\u043d\u0430\u043d\u043d\u044f.",
      "unknown": "\u0421\u0442\u0430\u043b\u0430\u0441\u044f \u043d\u0435\u043f\u0435\u0440\u0435\u0434\u0431\u0430\u0447\u0435\u043d\u0430 \u043f\u043e\u043c\u0438\u043b\u043a\u0430. \u041f\u0435\u0440\u0435\u0432\u0456\u0440\u0442\u0435 \u0436\u0443\u0440\u043d\u0430\u043b\u0438 Home Assistant \u0434\u043b\u044f \u043e\u0442\u0440\u0438\u043c\u0430\u043d\u043d\u044f \u0434\u0435\u0442\u0430\u043b\u0435\u0439.",
      "unsupported_modem": "\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u0435 \u0432\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u043d\u0435 \u0437\u043c\u043e\u0433\u043b\u043e \u0456\u0434\u0435\u043d\u0442\u0438\u0444\u0456\u043a\u0443\u0432\u0430\u0442\u0438 \u043c\u043e\u0434\u0435\u043b\u044c \u0432\u0430\u0448\u043e\u0433\u043e \u043c\u043e\u0434\u0435\u043c\u0443.\n\n\u0429\u043e\u0431 \u043f\u0440\u043e\u0434\u043e\u0432\u0436\u0438\u0442\u0438:\n1. \u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c '\u041d\u0435\u0432\u0456\u0434\u043e\u043c\u0438\u0439 \u043c\u043e\u0434\u0435\u043c (\u0440\u0435\u0437\u0435\u0440\u0432\u043d\u0438\u0439 \u0440\u0435\u0436\u0438\u043c)' \u0437\u0456 \u0441\u043f\u0430\u0434\u043d\u043e\u0433\u043e \u0441\u043f\u0438\u0441\u043a\u0443 \u043d\u0438\u0436\u0447\u0435\n2. \u0426\u0435 \u0432\u043c\u0438\u043a\u0430\u0454 \u0431\u0430\u0437\u043e\u0432\u0438\u0439 \u043c\u043e\u043d\u0456\u0442\u043e\u0440\u0438\u043d\u0433 \u0437'\u0454\u0434\u043d\u0430\u043d\u043d\u044f (\u0437\u0430\u0442\u0440\u0438\u043c\u043a\u0430 ping/HTTP)\n3. \u041f\u0456\u0441\u043b\u044f \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f \u043d\u0430\u0442\u0438\u0441\u043d\u0456\u0442\u044c \u043a\u043d\u043e\u043f\u043a\u0443 '\u0417\u0430\u0445\u043e\u043f\u0438\u0442\u0438 HTML'\n4. \u0417\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0442\u0435 \u0434\u0456\u0430\u0433\u043d\u043e\u0441\u0442\u0438\u043a\u0443 \u0442\u0430 \u043f\u043e\u0434\u0456\u043b\u0456\u0442\u044c\u0441\u044f \u0437 \u0440\u043e\u0437\u0440\u043e\u0431\u043d\u0438\u043a\u0430\u043c\u0438 \u0434\u043b\u044f \u0434\u043e\u0434\u0430\u0432\u0430\u043d\u043d\u044f \u043f\u043e\u0432\u043d\u043e\u0457 \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u043a\u0438"
