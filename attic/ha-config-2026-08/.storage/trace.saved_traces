    "automation.sproutie_exhaust_temp_control": [
      {
        "extended_dict": {
          "blueprint_inputs": null,
          "config": {
            "action": [
              {
                "action": "switch.turn_on",
                "target": {
                  "entity_id": "switch.exhaust_fan"
                }
              },
              {
                "action": "script.sproutie_log_event",
                "data": {
                  "color": "#e74c3c",
                  "icon": "mdi:fan",
                  "message": "Exhaust ON - Temp {{ states('sensor.monitor2_temperature') }}\u00b0F > {{ states('input_number.temp_trigger_max') }}\u00b0F",
                  "type": "Climate"
                }
              },
              {
                "timeout": {
                  "minutes": "{{ states('input_number.exhaust_on_duration') | int(15) }}"
                },
                "wait_template": "{{ states('sensor.monitor2_temperature') | float(100) < states('input_number.temp_trigger_min') | float(75) }}\n"
              },
              {
                "action": "switch.turn_off",
                "target": {
                  "entity_id": "switch.exhaust_fan"
                }
              },
              {
                "action": "input_datetime.set_datetime",
                "data": {
                  "datetime": "{{ now().strftime('%Y-%m-%d %H:%M:%S') }}"
                },
                "target": {
                  "entity_id": "input_datetime.exhaust_last_off_time"
                }
              },
              {
                "action": "script.sproutie_log_event",
                "data": {
                  "color": "#3498db",
                  "icon": "mdi:fan-off",
                  "message": "Exhaust OFF - {% if states('sensor.monitor2_temperature') | float(100) < states('input_number.temp_trigger_min') | float(75) %}Temp dropped to {{ states('sensor.monitor2_temperature') }}\u00b0F{% else %}Max run time reached{% endif %}\n",
                  "type": "Climate"
                }
              }
            ],
            "alias": "Exhaust Temperature Control",
            "condition": [
              {
                "condition": "state",
                "entity_id": "input_boolean.production_mode",
                "state": "on"
              },
              {
                "condition": "state",
                "entity_id": "input_boolean.schedule_exhaust_enabled",
                "state": "on"
              },
              {
                "condition": "state",
                "entity_id": "input_select.exhaust_mode",
                "state": "Temperature"
              },
              {
                "condition": "state",
                "entity_id": "switch.exhaust_fan",
                "state": "off"
              },
              {
                "condition": "template",
                "value_template": "{% set snooze_mins = states('input_number.exhaust_off_duration') | int(5) %} {% set last_off = states('input_datetime.exhaust_last_off_time') %} {% if last_off in ['unknown', 'unavailable', '1970-01-01 00:00:00'] %}\n  true\n{% else %}\n  {% set elapsed = (as_timestamp(now()) - as_timestamp(last_off)) / 60 %}\n  {{ elapsed >= snooze_mins }}\n{% endif %}\n"
              }
            ],
            "description": "Controls exhaust fan based on tent temperature thresholds",
            "id": "sproutie_exhaust_temp_control",
            "mode": "single",
            "trigger": [
              {
                "above": "input_number.temp_trigger_max",
                "entity_id": "sensor.monitor2_temperature",
                "platform": "numeric_state"
              }
            ]
          },
          "context": {
