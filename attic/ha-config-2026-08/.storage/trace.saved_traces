      {
        "extended_dict": {
          "blueprint_inputs": null,
          "config": {
            "alias": "Sproutie Log Event",
            "description": "Master script for logging events to Elasticsearch",
            "fields": {
              "action": {
                "description": "For System Audit events: The action taken (ON, OFF, ACTIVE, INACTIVE)",
                "example": "ON"
              },
              "audit_type": {
                "description": "For System Audit events: Hardware Change, Mode Change, etc.",
                "example": "Hardware Change"
              },
              "batch_id": {
                "description": "The batch ID (Tray ID)",
                "example": "1768093958"
              },
              "detail": {
                "description": "Event detail/description",
                "example": "Blackout"
              },
              "device": {
                "description": "For System Audit events: The device or mode being changed",
                "example": "Exhaust Fan"
              },
              "event_type": {
                "description": "Event type (Water, Phase Change, Issue, Harvest, Note, System Audit, etc.)",
                "example": "Phase Change"
              },
              "slot_id": {
                "description": "Optional representative slot ID (A1-B8)",
                "example": "A1"
              },
              "take_photo": {
                "default": false,
                "description": "Whether to capture a photo snapshot"
              }
            },
            "sequence": [
              {
                "variables": {
                  "matching_slots": "{% set bid = batch_id | default('') %} {% set slots = ['a1','a2','a3','a4','a5','a6','a7','a8','b1','b2','b3','b4','b5','b6','b7','b8','sc_tf','sc_tb','sc_bf','sc_bb'] %} {% set ns = namespace(list=[]) %} {% if bid != '' %}\n  {% for s in slots %}\n    {% set raw = states('input_text.slot_' ~ s ~ '_data') %}\n    {% if raw not in ['unknown', 'unavailable', 'Empty', ''] %}\n      {% set d = raw | from_json(default={}) %}\n      {% if d.get('id') | string | trim == bid | string | trim %}\n        {% set ns.list = ns.list + [s] %}\n      {% endif %}\n    {% endif %}\n  {% endfor %}\n{% endif %} {{ ns.list | to_json }}",
                  "target_slot": "{% set bid = batch_id | default('') %} {% set sid = slot_id | default('') %} {% if sid != '' %}\n  {{ sid }}\n{% elif bid != '' %}\n  {% set slots = ['a1','a2','a3','a4','a5','a6','a7','a8','b1','b2','b3','b4','b5','b6','b7','b8','sc_tf','sc_tb','sc_bf','sc_bb'] %}\n  {% set ns = namespace(slot='') %}\n  {% for s in slots %}\n    {% if ns.slot == '' %}\n      {% set raw = states('input_text.slot_' ~ s ~ '_data') %}\n      {% if raw not in ['unknown', 'unavailable', 'Empty', ''] %}\n        {% set d = raw | from_json(default={}) %}\n        {% if d.get('id') | string | trim == bid | string | trim %}\n          {% set ns.slot = s | upper %}\n        {% endif %}\n      {% endif %}\n    {% endif %}\n  {% endfor %}\n  {{ ns.slot }}\n{% else %}\n  \n{% endif %}"
                }
              },
              {
                "variables": {
                  "current_humidity": "{{ states('sensor.sproutie_outie_internal_humidity') | float(0) }}",
                  "current_temp": "{{ states('sensor.sproutie_outie_internal_temp') | float(0) }}",
                  "event_detail": "{% if event_type == 'Water' %}\n  {{ states('input_select.watering_type') }}\n{% elif event_type == 'Note' %}\n  {{ states('input_text.event_note') }}\n{% else %}\n  {{ detail | default('') }}\n{% endif %}",
                  "event_timestamp": "{% set manual = states('input_datetime.manual_event_date') %} {% if manual not in ['unknown', 'unavailable', '0', '1970-01-01 00:00:00'] %}\n  {{ as_datetime(manual).isoformat() }}\n{% else %}\n  {{ now().isoformat() }}\n{% endif %}",
                  "photo_url": "",
                  "target_batch": "{% set bid = batch_id | default('') %} {% if bid != '' %}\n  {{ bid }}\n{% else %}\n  {% set ts_lower = target_slot | lower %}\n  {% if ts_lower != '' %}\n    {% set raw = states('input_text.slot_' ~ ts_lower ~ '_data') %}\n    {% if raw not in ['unknown', 'unavailable', 'Empty', ''] %}\n      {{ (raw | from_json(default={})).get('id', 'unknown') }}\n    {% else %}\n      {{ states('input_text.selected_batch') | default('unknown') }}\n    {% endif %}\n  {% else %}\n    {{ states('input_text.selected_batch') | default('unknown') }}\n  {% endif %}\n{% endif %}"
                }
              },
              {
                "if": [
                  {
                    "condition": "template",
                    "value_template": "{{ take_photo | default(false) and target_slot != '' }}"
                  }
                ],
                "then": [
                  {
                    "variables": {
                      "camera_entity": "{% if target_slot[:3] | upper == 'SC_' %}\n  camera.sproutieos_esp32_1\n{% elif target_slot[0] | upper == 'A' %}\n  camera.top_eyes\n{% else %}\n  camera.bottom_eyes\n{% endif %}",
                      "filename": "{{ target_slot | lower }}_{{ timestamp_str }}.jpg",
                      "snapshot_path": "/config/www/snapshots/{{ filename }}",
                      "timestamp_str": "{{ as_timestamp(event_timestamp) | timestamp_custom('%Y%m%d_%H%M%S') }}"
                    }
                  },
                  {
                    "action": "camera.snapshot",
                    "data": {
                      "filename": "{{ snapshot_path }}"
                    },
                    "target": {
                      "entity_id": "{{ camera_entity }}"
                    }
                  },
                  {
                    "variables": {
                      "photo_url": "/local/snapshots/{{ filename }}"
                    }
                  }
                ]
              },
              {
                "action": "rest_command.sproutie_push_to_elastic",
                "data": {
                  "action": "{{ action | default('') }}",
                  "audit_type": "{{ audit_type | default('') }}",
                  "batch_id": "{{ target_batch }}",
                  "detail": "{{ event_detail }}",
                  "device": "{{ device | default('') }}",
                  "event_type": "{{ event_type }}",
                  "humidity": "{{ current_humidity }}",
                  "photo_url": "{{ photo_url }}",
                  "slot_id": "{{ target_slot }}",
                  "temp": "{{ current_temp }}",
                  "timestamp": "{{ event_timestamp }}"
                }
              },
              {
                "action": "browser_mod.notification",
                "data": {
                  "duration": 3000,
                  "message": "{% if event_type == 'System Audit' %}\n  System Audit logged\n{% else %}\n  {{ event_type }} logged for Batch {{ target_batch }}\n{% endif %}"
                }
              },
              {
                "action": "input_text.set_value",
                "data": {
                  "value": ""
                },
                "target": {
                  "entity_id": "input_text.event_note"
                }
              },
              {
                "action": "input_datetime.set_datetime",
                "data": {
                  "datetime": "1970-01-01 00:00:00"
                },
                "target": {
                  "entity_id": "input_datetime.manual_event_date"
                }
              }
            ]
          },
          "context": {
            "id": "01M19HCMEAF5A0VZNP8JDGNYCZ",
            "parent_id": "01M19HCMAZ5WZ8WBFARYZKGTG0",
