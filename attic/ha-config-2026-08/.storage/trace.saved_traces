                    "conditions": [
                      {
                        "condition": "state",
                        "entity_id": "switch.exhaust_fan",
                        "state": "on"
                      }
                    ],
                    "sequence": [
                      {
                        "if": [
                          {
                            "condition": "template",
                            "value_template": "{{ elapsed_minutes >= on_duration }}"
                          }
                        ],
                        "then": [
