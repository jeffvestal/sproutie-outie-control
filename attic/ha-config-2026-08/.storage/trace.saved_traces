      {
        "extended_dict": {
          "blueprint_inputs": null,
          "config": {
            "alias": "Sequence Crop Photography",
            "description": "Turns on the flash, takes snapshots for all active crops, and turns off the flash",
            "sequence": [
              {
                "action": "scene.create",
                "data": {
                  "scene_id": "sproutie_pre_photo_scene",
                  "snapshot_entities": [
                    "switch.top_shelf_lights",
                    "switch.bottom_shelf_lights"
                  ]
                }
              },
              {
                "action": "switch.turn_off",
                "target": {
                  "entity_id": [
                    "switch.top_shelf_lights",
                    "switch.bottom_shelf_lights"
                  ]
                }
              },
              {
                "delay": "00:00:01"
              },
              {
                "action": "switch.turn_on",
                "target": {
                  "entity_id": "switch.camera_flash"
                }
              },
              {
                "delay": "00:00:05"
              },
              {
                "variables": {
                  "active_crops": "{% set slots = ['a1','a2','a3','a4','a5','a6','a7','a8','b1','b2','b3','b4','b5','b6','b7','b8','sc_tf','sc_tb','sc_bf','sc_bb'] %} {% set ns = namespace(batches={}) %} {% for s in slots %}\n  {% set raw = states('input_text.slot_' ~ s ~ '_data') %}\n  {% if raw not in ['unknown', 'unavailable', 'Empty', ''] %}\n    {% set d = raw | from_json(default={}) %}\n    {% if d.get('id') is defined %}\n      {% set ns.batches = dict(ns.batches, **{d.get('id') | string: s}) %}\n    {% endif %}\n  {% endif %}\n{% endfor %} {{ ns.batches.items() | list }}",
                  "timestamp": "{{ now().strftime('%Y%m%d_%H%M%S') }}"
                }
              },
              {
                "repeat": {
                  "for_each": "{{ active_crops }}",
                  "sequence": [
                    {
                      "variables": {
                        "batch_id": "{{ repeat.item[0] }}",
                        "camera_entity": "{% if slot_id[:3] | upper == 'SC_' %}\n  camera.sproutieos_esp32_1\n{% elif slot_id[0] | upper == 'A' %}\n  camera.top_eyes\n{% else %}\n  camera.bottom_eyes\n{% endif %}",
                        "crop_data": "{{ states('input_text.slot_' ~ slot_id | lower ~ '_data') | from_json(default={}) }}",
                        "crop_name": "{{ crop_data.get('crop', 'unknown') | replace(' ', '_') | lower }}",
                        "full_filename": "{{ crop_name }}_{{ batch_id | default('unknown') }}_{{ timestamp }}.jpg",
                        "slot_id": "{{ repeat.item[1] }}"
                      }
                    },
                    {
                      "action": "camera.snapshot",
                      "continue_on_error": true,
                      "data": {
                        "filename": "/config/www/snapshots/{{ full_filename }}"
                      },
                      "target": {
                        "entity_id": "{{ camera_entity }}"
                      }
                    },
                    {
                      "delay": "00:00:02"
                    },
                    {
                      "action": "shell_command.copy_snapshot",
                      "continue_on_error": true,
                      "data": {
                        "source": "/config/www/snapshots/{{ full_filename }}",
                        "target": "{% if slot_id[:3] | upper == 'SC_' %}\n  /config/www/snapshots/sidecar_eyes_latest.jpg\n{% elif slot_id[0] | upper == 'A' %}\n  /media/snapshots/top_eyes_latest.jpg\n{% else %}\n  /media/snapshots/bottom_eyes_latest.jpg\n{% endif %}"
                      }
                    },
                    {
                      "action": "shell_command.upload_snapshot_to_gcp",
                      "continue_on_error": true,
                      "data": {
                        "filename": "/config/www/snapshots/{{ full_filename }}"
                      }
                    },
                    {
                      "action": "rest_command.sproutie_push_to_elastic",
                      "continue_on_error": true,
                      "data": {
                        "batch_id": "{{ batch_id | default('unknown') }}",
                        "detail": "Periodic photography sequence snapshot",
                        "event_type": "Snapshot",
                        "humidity": "{{ states('sensor.sproutie_outie_internal_humidity') | float(0) }}",
                        "photo_url": "/local/snapshots/{{ full_filename }}",
                        "slot_id": "{{ slot_id }}",
                        "temp": "{{ states('sensor.sproutie_outie_internal_temp') | float(0) }}",
                        "timestamp": "{{ now().isoformat() }}"
                      }
                    }
                  ]
                }
              },
              {
                "delay": "00:00:02"
              },
              {
                "action": "switch.turn_off",
                "continue_on_error": true,
                "target": {
                  "entity_id": "switch.camera_flash"
                }
              },
              {
                "action": "scene.turn_on",
                "continue_on_error": true,
                "target": {
                  "entity_id": "scene.sproutie_pre_photo_scene"
                }
              },
              {
                "action": "homeassistant.update_entity",
                "target": {
                  "entity_id": [
                    "camera.top_eyes_snapshot",
                    "camera.bottom_eyes_snapshot",
                    "camera.sidecar_eyes_snapshot"
                  ]
                }
              },
              {
                "delay": "00:00:02"
              },
              {
                "action": "homeassistant.update_entity",
                "target": {
                  "entity_id": [
                    "camera.top_eyes_snapshot",
                    "camera.bottom_eyes_snapshot",
                    "camera.sidecar_eyes_snapshot"
                  ]
                }
              },
              {
                "action": "input_datetime.set_datetime",
                "data": {
                  "datetime": "{{ now().strftime('%Y-%m-%d %H:%M:%S') }}"
                },
                "target": {
                  "entity_id": "input_datetime.last_photography_success"
                }
              }
            ]
          },
