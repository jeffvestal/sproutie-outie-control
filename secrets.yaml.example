# Copy to secrets.yaml on the HA box (/config/secrets.yaml) and fill in.
# secrets.yaml is gitignored and must NEVER be committed.
#
# Issue #2: the Eufy password and the GCP bearer token were committed in plaintext to this
# public repo. Both are rotated. Nothing below belongs in a tracked file ever again.

# --- Eufy cameras ---------------------------------------------------------
# Moves out of configuration.yaml's `eufy:` block, which held these in plaintext.
eufy_username: ""
eufy_password: ""

# --- GCP snapshot upload --------------------------------------------------
# The Cloud Function validates this against its own AUTH_TOKEN env var.
# Rotating means changing BOTH: the function's env var and the two commands below.
gcp_upload_command: >-
  bash /config/scripts/upload_snapshot.sh "{{ source }}"
  "https://us-central1-<PROJECT>.cloudfunctions.net/upload_snapshot"
  "<AUTH_TOKEN>"
gcp_maintenance_command: >-
  bash /config/scripts/snapshot_maintenance.sh
  "https://us-central1-<PROJECT>.cloudfunctions.net/upload_snapshot"
  "<AUTH_TOKEN>"

# --- Elasticsearch --------------------------------------------------------
# The two REST sensors in packages/sproutie_outie/sensors.yaml (~L1195, ~L1213) currently
# carry the cluster URL inline, unlike every other ES call. Move them onto these.
elastic_url_search: "https://<CLUSTER>.es.<REGION>.gcp.elastic.cloud:443"
elastic_url_doc: "https://<CLUSTER>.es.<REGION>.gcp.elastic.cloud:443"
elastic_api_key: ""
